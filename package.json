{
  "name": "k0nnect",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "desktop:frontend": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "build": "CLOUDFLARE_ENV=production vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy --env production",
    "deploy:dry-run": "pnpm build && wrangler deploy --env production --dry-run",
    "types:worker": "wrangler types",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/integration/security.test.ts tests/integration/auth-hardening.test.ts tests/integration/database-security.test.ts tests/integration/websocket.test.ts tests/unit/crypto.test.ts tests/unit/schemas.test.ts tests/unit/turnstile.test.ts tests/unit/cloudflare-realtime.test.ts",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply k0nnect --local",
    "db:migrate:remote": "wrangler d1 migrations apply k0nnect --remote --env production",
    "setup:local": "tsx scripts/setup-local.ts",
    "invite:create": "tsx scripts/create-invite.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm types:worker:check && pnpm test && pnpm build",
    "types:worker:check": "wrangler types --check",
    "audit:dependencies": "pnpm audit --audit-level high"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "hono": "4.13.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260829.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
